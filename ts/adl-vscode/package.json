{
  "name": "adl-vscode",
  "displayName": "ADL",
  "description": "LSP support for Algebraic Data Language",
  "repository": "https://github.com/alexytsu/adl-lsp",
  "icon": "assets/adl-icon.png",
  "publisher": "alexytsu",
  "version": "0.4.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "ADL",
      "properties": {
        "adl.lspPath": {
          "type": "string",
          "default": "adl-lsp",
          "description": "Path to the ADL server executable."
        },
        "adl.cargoPath": {
          "type": "string",
          "default": "cargo",
          "description": "Path to the cargo binary used in development mode."
        },
        "adl.searchDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "."
          ],
          "description": "Directories to search for ADL files, relative to the workspace folder. Package roots inside them are found from adl-package.json files and module names, so the workspace folder itself is usually enough."
        },
        "adl.stdlibDir": {
          "type": "string",
          "default": "",
          "description": "Directory containing the ADL standard library (the one holding sys/types.adl). Leave empty to use the one installed with your ADL toolchain, or the copy bundled with adl-lsp when none is found."
        }
      }
    },
    "languages": [
      {
        "id": "adl",
        "extensions": [
          ".adl",
          ".adl-cpp",
          ".adl-hs",
          ".adl-java",
          ".adl-rs",
          ".adl-ts",
          ".adl-pg",
          ".adl-py"
        ],
        "aliases": [
          "ADL",
          "adl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "assets/adl-file-light.png",
          "dark": "assets/adl-file-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "adl",
        "scopeName": "source.adl",
        "path": "./syntaxes/adl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "adl-vscode.restart-language-server",
        "title": "ADL: Restart Language Server"
      },
      {
        "command": "adl-vscode.update-language-server",
        "title": "ADL: Update Language Server"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "vsix": "../../scripts/package-extension.sh",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
